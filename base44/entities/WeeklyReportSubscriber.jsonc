{
  "name": "WeeklyReportSubscriber",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of report recipient (JPGE HQ staff)"
    },
    "email": {
      "type": "string",
      "description": "Email address \u2014 must be a registered app user"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this subscriber currently receives the weekly report"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}