{
  "name": "FormTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "pipeline",
        "donor",
        "standard"
      ],
      "default": "pipeline",
      "description": "Where the template came from. 'standard' is the platform-standard template built from the central form library."
    },
    "grant_id": {
      "type": "string",
      "description": "Reference to Grant entity, when known"
    },
    "grant_title": {
      "type": "string"
    },
    "funder": {
      "type": "string"
    },
    "program_name": {
      "type": "string",
      "description": "Program or opportunity name (donor listings)"
    },
    "application_link": {
      "type": "string",
      "description": "Official application page / portal URL (the primary source)"
    },
    "application_id": {
      "type": "string",
      "description": "Linked GrantApplication id once saved to the pipeline"
    },
    "supplemental_links": {
      "type": "array",
      "description": "Additional official links used for research: documentation pages, requirements pages, application portals, or direct form downloads",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "portal",
              "documentation",
              "requirements",
              "document",
              "page",
              "other"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "public",
              "signin_required",
              "unknown"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "description": "Fillable or supporting documents located from the sources (application forms, budget spreadsheets, guidelines, checklists)",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Direct URL of the document"
          },
          "kind": {
            "type": "string",
            "enum": [
              "application_form",
              "budget_template",
              "guidelines",
              "checklist",
              "portal",
              "other"
            ]
          },
          "access": {
            "type": "string",
            "enum": [
              "public",
              "signin_required",
              "unknown"
            ]
          },
          "file_uri": {
            "type": "string",
            "description": "Private storage copy captured when the document was publicly downloadable"
          },
          "extracted_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fillable fields, columns or line items the document asks for"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "access_notes": {
      "type": "string",
      "description": "What remains inaccessible behind a registration or sign-in wall, and what the public pages say an applicant needs once registered"
    },
    "standard_template_id": {
      "type": "string",
      "description": "Platform-standard template this was tailored from"
    },
    "eligibility_summary": {
      "type": "string",
      "description": "Applicant eligibility in plain language"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Concrete submission requirements"
    },
    "prompts": {
      "type": "array",
      "description": "Validated application form prompts",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "word_limit": {
            "type": "string"
          },
          "requirement_link": {
            "type": "string"
          },
          "evidence_source": {
            "type": "string"
          },
          "evidence_excerpt": {
            "type": "string"
          },
          "validation_status": {
            "type": "string",
            "enum": [
              "validated",
              "unverified",
              "conflict",
              "missing"
            ]
          },
          "validation_note": {
            "type": "string"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "grant_specific",
              "standard"
            ],
            "description": "grant_specific: taken from this funder's own application materials. standard: platform-standard guidance used where this opportunity requires a section but does not spell it out."
          }
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "description": "Counts of prompts by validation status",
      "properties": {
        "validated": {
          "type": "number"
        },
        "unverified": {
          "type": "number"
        },
        "conflicts": {
          "type": "number"
        },
        "missing": {
          "type": "number"
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Items that could not be verified from official sources"
    },
    "sources": {
      "type": "array",
      "description": "Official sources used",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "access": {
            "type": "string",
            "enum": [
              "public",
              "signin_required",
              "unknown"
            ]
          }
        }
      }
    },
    "official_documentation_found": {
      "type": "boolean",
      "default": false,
      "description": "True only when the funder's own application materials were located"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "saved"
      ],
      "default": "draft"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}