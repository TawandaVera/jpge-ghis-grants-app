{
  "name": "Application Stage Change Tracker",
  "description": "On every grant application create/update: syncs workspace counts, auto-creates HIL checkpoints at hil_review stage, and notifies admins on submission",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "GrantApplication"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "application_stage_change_tracker",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onApplicationChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}